msgid "social accounts"
msgstr "حساب‌های اجتماعی"

msgid "subject"
msgstr "موضوع"

msgid "this field cannot be null."
msgstr "این فیلد نمی‌تواند خالی باشد."

msgid "title"
msgstr "عنوان"

msgid "token is invalid or expired."
msgstr "توکن نامعتبر یا منقضی است."

msgid "unable to log in with provided credentials."
msgstr "ورود با اطلاعات وارد شده ممکن نیست."

msgid "updated at"
msgstr "به‌روزرسانی شده در"

