msgid "invalid reference."
msgstr "ارجاع نامعتبر است."

msgid "is active"
msgstr "فعال است"

msgid "is admin"
msgstr "مدیر است"

msgid "is public"
msgstr "عمومی است"

msgid "managed file"
msgstr "فایل مدیریت‌شده"

msgid "managed files"
msgstr "فایل‌های مدیریت‌شده"

