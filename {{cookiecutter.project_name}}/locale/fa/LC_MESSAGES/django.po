msgid "%(field)s already exists."
msgstr "%(field)s از قبل وجود دارد."

msgid "Apple login is not configured."
msgstr "ورود با اپل پیکربندی نشده است."

msgid "Apple token is missing subject."
msgstr "توکن اپل فاقد شناسه موضوع است."

msgid "Authentication is required to confirm a profile phone change."
msgstr "برای تأیید تغییر تلفن پروفایل، احراز هویت لازم است."

msgid "Dashboard"
msgstr "داشبورد"

msgid "Enter a valid mobile number (e.g. 989134543456)."
msgstr "یک شماره موبایل معتبر وارد کنید (مثلاً 989134543456)."

msgid "Google login is not configured."
msgstr "ورود با گوگل پیکربندی نشده است."

msgid "Google token is missing email or subject."
msgstr "توکن گوگل فاقد ایمیل یا شناسه موضوع است."

msgid "Invalid Apple id_token."
msgstr "شناسه توکن اپل نامعتبر است."

msgid "Invalid Google id_token."
msgstr "شناسه توکن گوگل نامعتبر است."

msgid "Invalid Microsoft id_token."
msgstr "شناسه توکن مایکروسافت نامعتبر است."

msgid "Invalid verification challenge."
msgstr "چالش تأیید نامعتبر است."

msgid "Invalid verification code."
msgstr "کد تأیید نامعتبر است."

msgid "Microsoft login is not configured."
msgstr "ورود با مایکروسافت پیکربندی نشده است."

msgid "Microsoft token is missing email or subject."
msgstr "توکن مایکروسافت فاقد ایمیل یا شناسه موضوع است."

msgid "Navigation"
msgstr "ناوبری"

msgid "Phone does not match the verification challenge."
msgstr "تلفن با چالش تأیید مطابقت ندارد."

msgid "Please wait before requesting another code."
msgstr "لطفاً قبل از درخواست کد دیگر صبر کنید."

msgid "Provider did not return an email; cannot create an account."
msgstr "ارائه‌دهنده ایمیلی برنگرداند؛ امکان ایجاد حساب وجود ندارد."

msgid "Provider email is not verified."
msgstr "ایمیل ارائه‌دهنده تأیید نشده است."

msgid "This account is inactive."
msgstr "این حساب غیرفعال است."

msgid "This verification code does not belong to the current user."
msgstr "این کد تأیید متعلق به کاربر فعلی نیست."

msgid "Too many invalid attempts. Request a new code."
msgstr "تلاش‌های نامعتبر بیش از حد. کد جدیدی درخواست کنید."

msgid "Verification code expired or not requested."
msgstr "کد تأیید منقضی شده یا درخواست نشده است."

msgid "Your verification code is {code}."
msgstr "کد تأیید شما {code} است."

msgid "a conflicting record already exists."
msgstr "یک رکورد متناقض از قبل وجود دارد."

msgid "a required database field is missing."
msgstr "یک فیلد الزامی پایگاه داده وجود ندارد."

msgid "a server error occurred."
msgstr "خطای سرور رخ داد."

msgid "avatar"
msgstr "آواتار"

msgid "bio"
msgstr "بیوگرافی"

msgid "cannot change avatar in the same request as phone; update avatar separately."
msgstr "نمی‌توان آواتار را در همان درخواست تغییر تلفن عوض کرد؛ آواتار را جداگانه به‌روزرسانی کنید."

msgid "cannot clear phone before one is set; provide a phone to verify."
msgstr "نمی‌توان تلفن را قبل از تنظیم پاک کرد؛ یک تلفن برای تأیید ارائه دهید."

msgid "category"
