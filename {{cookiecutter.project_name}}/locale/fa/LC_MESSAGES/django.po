msgstr "رمز عبور باید حداقل %(limit_value)d کاراکتر باشد"

msgid "password must include letter"
msgstr "رمز عبور باید شامل حرف باشد"

msgid "password must include number"
msgstr "رمز عبور باید شامل عدد باشد"

msgid "password must include special char"
