msgid "file extension .%(ext)s is not allowed. allowed extensions: %(allowed)s."
msgstr "پسوند فایل .%(ext)s مجاز نیست. پسوندهای مجاز: %(allowed)s."

msgid "file manager"
msgstr "مدیریت فایل"

msgid "file size"
msgstr "اندازه فایل"

