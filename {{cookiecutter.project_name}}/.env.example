SECRET_KEY='django-insecure-change-me-local-only'
DEBUG=true
DATABASE_URL=psql://{{cookiecutter.postgres_user}}:{{cookiecutter.postgres_password}}@127.0.0.1:5432/{{cookiecutter.project_slug}}
{%- if cookiecutter.use_redis == "y" %}
# Redis DB map: /0 cache · /1 sessions-throttle-otp · /2 channels · /3 celery (redis broker)
REDIS_LOCATION=redis://localhost:6379/0
{%- if cookiecutter.use_websockets == "y" %}
REDIS_CHANNEL_LAYER_LOCATION=redis://localhost:6379/2
{%- endif %}
{%- endif %}
{%- if cookiecutter.use_rabbitmq == "y" %}
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
{%- endif %}
{%- if cookiecutter.use_celery == "y" and cookiecutter.celery_broker == "redis" %}
CELERY_BROKER_URL=redis://localhost:6379/3
# CELERY_TASK_ALWAYS_EAGER=true
{%- elif cookiecutter.use_celery == "y" %}
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# CELERY_TASK_ALWAYS_EAGER=true
{%- endif %}

ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.django.local
APP_DOMAIN=http://localhost:8000
{%- if cookiecutter.use_i18n == "y" %}
LANGUAGE_CODE=en
{%- endif %}

# CORS (local settings force CORS_ALLOW_ALL_ORIGINS=true; production uses the list below)
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Email (password reset uses console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Logging (see README → Logging)
DJANGO_LOGGING_LEVEL=INFO
LOG_TO_FILE=true
LOG_WHEN=midnight
LOG_INTERVAL=1
LOG_BACKUP_COUNT=14
LOG_SQL=false
{%- if cookiecutter.use_jwt == "y" %}

JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=604800
{%- endif %}
{%- if cookiecutter.use_otp_login == "y" %}

# OTP login — when true, code is always 12345 and SMS is not sent
OTP_TEST=true
# SMS_PROVIDER=stub
# OTP_TTL_SECONDS=120
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5
{%- endif %}
{%- if cookiecutter.use_google_login == "y" or cookiecutter.use_microsoft_login == "y" or cookiecutter.use_apple_login == "y" %}

# Social login — frontend obtains id_token; API verifies and issues JWT/session
{%- if cookiecutter.use_google_login == "y" %}
GOOGLE_OAUTH_CLIENT_ID=
{%- endif %}
{%- if cookiecutter.use_microsoft_login == "y" %}
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT=common
{%- endif %}
{%- if cookiecutter.use_apple_login == "y" %}
APPLE_OAUTH_CLIENT_ID=
{%- endif %}
{%- endif %}
{%- if cookiecutter.use_sentry == "y" %}

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
{%- endif %}

# Production database connection pooling (seconds)
# CONN_MAX_AGE=60

# Production TLS (set when serving HTTPS behind nginx/traefik)
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
